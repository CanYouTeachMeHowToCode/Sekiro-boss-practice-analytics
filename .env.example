# Copy to .env (which is git-ignored) and set your own values.
POSTGRES_DB=sekiro
POSTGRES_USER=sekiro
POSTGRES_PASSWORD=change-me

# Used when running the backend, Alembic, or database tests from the host
# (outside Docker). Inside docker compose the backend gets its own URL.
DATABASE_URL=postgresql+psycopg://sekiro:change-me@localhost:5432/sekiro
TEST_DATABASE_URL=postgresql+psycopg://sekiro:change-me@localhost:5432/sekiro_test
