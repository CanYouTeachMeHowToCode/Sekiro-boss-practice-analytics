# The server's .env, in the repository folder (deploy/setup.sh writes it with random secrets; this is its shape).
# Never commit the real one.

# both Compose files, so a plain `docker compose ...` uses them
COMPOSE_FILE=docker-compose.yml:deploy/compose.server.yml
COMPOSE_PROJECT_NAME=sekiro

POSTGRES_PASSWORD=<random>

# the analysis data folder, uploaded from the owner's computer (analysis/README.md)
ANALYSIS_DATA=/srv/sekiro/analysis-data

# the site's address: a domain pointing to the server, or <ip-with-dashes>.sslip.io
SITE_ADDRESS=1-2-3-4.sslip.io
SITE_USER=tester
# bcrypt hash of the shared password (caddy hash-password); single quotes keep the $ signs literal
SITE_PASSWORD_HASH='$2a$14$...'
